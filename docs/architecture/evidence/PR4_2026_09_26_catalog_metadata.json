  "functions": [
    {
      "nspname": "glam_private",
      "proname": "add_service",
      "args": "p_org uuid, p_name text, p_minutes integer, p_price numeric",
      "returns": "uuid",
      "prosecdef": true,
      "proconfig": [
        "search_path=\"\""
      ],
      "owner": "postgres",
      "proacl": "{postgres=X/postgres,authenticated=X/postgres}",
      "anon_exec": false,
      "authenticated_exec": true,
      "definition": "CREATE OR REPLACE FUNCTION glam_private.add_service(p_org uuid, p_name text, p_minutes integer, p_price numeric)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare result uuid;\nbegin\n if auth.uid() is null or not exists(select 1 from public.glam_memberships where organization_id=p_org and user_id=auth.uid() and role in ('owner','manager')) then raise exception 'FORBIDDEN'; end if;\n insert into public.glam_services(organization_id,name,minutes,price_sar) values(p_org,trim(p_name),p_minutes,p_price) returning id into result;\n return result;\nend $function$\n"
    },
    {
      "nspname": "glam_private",
      "proname": "edit_service",
      "args": "p_id uuid, p_name text, p_minutes integer, p_price numeric, p_active boolean",
      "returns": "uuid",
      "prosecdef": true,
      "proconfig": [
        "search_path=\"\""
      ],
      "owner": "postgres",
      "proacl": "{postgres=X/postgres,authenticated=X/postgres}",
      "anon_exec": false,
      "authenticated_exec": true,
      "definition": "CREATE OR REPLACE FUNCTION glam_private.edit_service(p_id uuid, p_name text, p_minutes integer, p_price numeric, p_active boolean)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare s public.glam_services;\nbegin\n select * into s from public.glam_services where id=p_id for update;\n if auth.uid() is null or not found or not exists(select 1 from public.glam_memberships where organization_id=s.organization_id and user_id=auth.uid() and role in ('owner','manager')) then raise exception 'FORBIDDEN'; end if;\n update public.glam_services set name=trim(p_name),minutes=p_minutes,price_sar=p_price,active=p_active,\n revision=revision+case when (name,minutes,price_sar) is distinct from (trim(p_name),p_minutes,p_price) then 1 else 0 end where id=p_id;\n return p_id;\nend $function$\n"
    },
    {
      "nspname": "public",
      "proname": "glam_add_service",
      "args": "p_org uuid, p_name text, p_minutes integer, p_price numeric",
      "returns": "uuid",
      "prosecdef": false,
      "proconfig": [
        "search_path=\"\""
      ],
      "owner": "postgres",
      "proacl": "{postgres=X/postgres,authenticated=X/postgres}",
      "anon_exec": false,
      "authenticated_exec": true,
      "definition": "CREATE OR REPLACE FUNCTION public.glam_add_service(p_org uuid, p_name text, p_minutes integer, p_price numeric)\n RETURNS uuid\n LANGUAGE sql\n SET search_path TO ''\nAS $function$select glam_private.add_service(p_org,p_name,p_minutes,p_price)$function$\n"
    },
